{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "lib": [
            "es2022"
        ],
        "types": [
            "@cloudflare/workers-types"
        ],
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*"
    ]
}